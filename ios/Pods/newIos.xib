<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23727" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23721"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="Stack View" minToolsVersion="7.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="view1">
            <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <!-- Background Image (full screen) -->
                <imageView userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="placeholder_banner" translatesAutoresizingMaskIntoConstraints="NO" id="bannerImage"/>
                
                <!-- Dark overlay for better text visibility -->
                <view alpha="0.6" userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="darkOverlay">
                    <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                    <color key="backgroundColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </view>
                
                <!-- Main Content Stack -->
                <stackView axis="vertical" alignment="fill" distribution="fill" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="mainStack">
                    <rect key="frame" x="16" y="519" width="343" height="132"/>
                    
                    <!-- App Info Stack -->
                    <stackView axis="vertical" alignment="leading" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="infoStack">
                        <!-- Icon + Title -->
                        <stackView axis="horizontal" alignment="center" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="iconTitleStack">
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="app_icon" translatesAutoresizingMaskIntoConstraints="NO" id="appIcon">
                                <constraints>
                                    <constraint firstAttribute="width" constant="60" id="appIconWidth"/>
                                    <constraint firstAttribute="height" constant="60" id="appIconHeight"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Game of War - Fire Age" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="appTitle">
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="18"/>
                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </stackView>
                        
                        <!-- Description -->
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Attackers and Defenders Beware: War is coming. Play at your own risk!" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="descriptionLabel">
                            <fontDescription key="fontDescription" type="system" pointSize="14"/>
                            <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            <nil key="highlightedColor"/>
                        </label>
                        
                        <!-- Rating -->
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="★★★★★ (958,441)" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ratingLabel">
                            <fontDescription key="fontDescription" type="system" pointSize="13"/>
                            <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            <nil key="highlightedColor"/>
                        </label>
                    </stackView>
                    
                    <!-- Install Button -->
                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="installButton">
                        <rect key="frame" x="0.0" y="108" width="343" height="50"/>
                        <color key="backgroundColor" systemColor="linkColor"/>
                        <constraints>
                            <constraint firstAttribute="height" constant="50" id="buttonHeight"/>
                        </constraints>
                        <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="17"/>
                        <state key="normal" title="INSTALL">
                            <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        </state>
                        <connections>
                            <action selector="installButtonTapped:" destination="-1" eventType="touchUpInside" id="buttonAction"/>
                        </connections>
                    </button>
                </stackView>
            </subviews>
            
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <!-- Background Image Constraints -->
                <constraint firstItem="bannerImage" firstAttribute="top" secondItem="view1" secondAttribute="top" id="bannerTop"/>
                <constraint firstItem="bannerImage" firstAttribute="leading" secondItem="view1" secondAttribute="leading" id="bannerLeading"/>
                <constraint firstItem="bannerImage" firstAttribute="trailing" secondItem="view1" secondAttribute="trailing" id="bannerTrailing"/>
                <constraint firstItem="bannerImage" firstAttribute="bottom" secondItem="view1" secondAttribute="bottom" id="bannerBottom"/>
                
                <!-- Dark Overlay Constraints -->
                <constraint firstItem="darkOverlay" firstAttribute="top" secondItem="view1" secondAttribute="top" id="overlayTop"/>
                <constraint firstItem="darkOverlay" firstAttribute="leading" secondItem="view1" secondAttribute="leading" id="overlayLeading"/>
                <constraint firstItem="darkOverlay" firstAttribute="trailing" secondItem="view1" secondAttribute="trailing" id="overlayTrailing"/>
                <constraint firstItem="darkOverlay" firstAttribute="bottom" secondItem="view1" secondAttribute="bottom" id="overlayBottom"/>
                
                <!-- Main Stack Constraints -->
                <constraint firstItem="mainStack" firstAttribute="leading" secondItem="view1" secondAttribute="leading" constant="16" id="mainStackLeading"/>
                <constraint firstItem="mainStack" firstAttribute="trailing" secondItem="view1" secondAttribute="trailing" constant="-16" id="mainStackTrailing"/>
                <constraint firstItem="mainStack" firstAttribute="bottom" secondItem="view1.safeArea" secondAttribute="bottom" constant="-16" id="mainStackBottom"/>
            </constraints>
            <viewLayoutGuide key="safeArea" id="safeArea"/>
        </view>
    </objects>
    <resources>
        <!-- Placeholder images - replace with your actual assets -->
        <image name="app_icon" width="60" height="60"/>
        <image name="placeholder_banner" width="375" height="667"/>
        
        <systemColor name="linkColor">
            <color red="0.0" green="0.47843137254901963" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
