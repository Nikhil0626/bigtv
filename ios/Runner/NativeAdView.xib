<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23727" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" colorMatched="YES">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment version="2048" identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23721"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="iN0-l3-epB" customClass="GADNativeAdView">
            <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <view contentMode="scaleAspectFill" translatesAutoresizingMaskIntoConstraints="NO" id="mediaView" customClass="GADMediaView">
                    <rect key="frame" x="0.0" y="0.0" width="375" height="666"/>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                </view>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="infoBar">
                    <rect key="frame" x="0.0" y="0.0" width="375" height="24"/>
                    <subviews>
                        <imageView contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="adBadge">
                            <rect key="frame" x="347" y="2" width="20" height="20"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="20" id="badge-height"/>
                                <constraint firstAttribute="width" constant="20" id="badge-width"/>
                            </constraints>
                        </imageView>
                    </subviews>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                    <constraints>
                        <constraint firstItem="adBadge" firstAttribute="centerY" secondItem="infoBar" secondAttribute="centerY" id="badge-centerY"/>
                        <constraint firstItem="adBadge" firstAttribute="trailing" secondItem="infoBar" secondAttribute="trailing" constant="-8" id="badge-trailing"/>
                        <constraint firstAttribute="height" constant="24" id="infoBar-height"/>
                    </constraints>
                </view>

                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="contentContainer">
                    <rect key="frame" x="0.0" y="480" width="300" height="180"/>
                    <subviews>
                        <!-- Headline -->
                        <label contentMode="scaleToFill" text="Headline" translatesAutoresizingMaskIntoConstraints="NO" id="headline">
                            <rect key="frame" x="8" y="8" width="300" height="24"/>
                            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                            <fontDescription key="fontDescription" type="system" pointSize="16"/>
                            <color key="textColor" white="0.0" alpha="1" colorSpace="calibratedWhite"/>
                        </label>

                        <!-- Body -->
                        <label contentMode="scaleToFill" text="Body text goes here and can be long." numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="body">
                            <rect key="frame" x="8" y="40" width="300" height="32"/>
                            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                            <fontDescription key="fontDescription" type="system" pointSize="14"/>
                            <color key="textColor" white="0.0" alpha="1" colorSpace="calibratedWhite"/>
                        </label>

                        <!-- CTA Button -->
                        <button contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="ctaButton">
                            <rect key="frame" x="14" y="85" width="375" height="30"/>
                            <color key="backgroundColor" red="0.0" green="0.5" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            <state key="normal" title="INSTALL">
                                <color key="titleColor" white="1" alpha="1" colorSpace="calibratedWhite"/>
                            </state>
                            <userDefinedRuntimeAttributes>
                                <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                    <integer key="value" value="8"/>
                                </userDefinedRuntimeAttribute>
                                <userDefinedRuntimeAttribute type="boolean" keyPath="clipsToBounds" value="YES"/>
                            </userDefinedRuntimeAttributes>
                        </button>
                    </subviews>

                    <!-- Container styling -->
                    <color key="backgroundColor" red="0.3" green="0.5" blue="0.8" alpha="0" colorSpace="custom" customColorSpace="sRGB"/>
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                            <integer key="value" value="12"/>
                        </userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="boolean" keyPath="clipsToBounds" value="YES"/>
                    </userDefinedRuntimeAttributes>

                    <!-- Constraints -->
                    <constraints>
                        <!-- Headline -->
                        <constraint firstItem="headline" firstAttribute="leading" secondItem="contentContainer" secondAttribute="leading" constant="8"/>
                        <constraint firstItem="headline" firstAttribute="top" secondItem="contentContainer" secondAttribute="top" constant="8"/>
                        <constraint firstAttribute="trailing" secondItem="headline" secondAttribute="trailing" constant="-4"/>

                        <!-- Body (directly below headline now) -->
                        <constraint firstItem="body" firstAttribute="leading" secondItem="headline" secondAttribute="leading"/>
                        <constraint firstItem="body" firstAttribute="top" secondItem="headline" secondAttribute="bottom" constant="4"/>
                        <constraint firstAttribute="trailing" secondItem="body" secondAttribute="trailing" constant="-8"/>

                        <!-- CTA Button (with padding from body) -->
                        <constraint firstItem="ctaButton" firstAttribute="top" secondItem="body" secondAttribute="bottom" constant="-12"/>
                        <constraint firstItem="ctaButton" firstAttribute="leading" secondItem="contentContainer" secondAttribute="leading" constant="-12"/>
                        <constraint firstAttribute="trailing" secondItem="ctaButton" secondAttribute="trailing" constant="-12"/>
                        <constraint firstItem="ctaButton" firstAttribute="bottom" secondItem="contentContainer" secondAttribute="bottom" constant="-20"/>
                        <constraint firstItem="ctaButton" firstAttribute="height" constant="30"/>
                    </constraints>
                </view>




