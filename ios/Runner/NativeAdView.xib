<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23727" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" colorMatched="YES">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment version="2048" identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23721"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="iN0-l3-epB" customClass="GADNativeAdView">
            <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <!-- Media View - Positioned at top, not full screen -->
                <view contentMode="scaleAspectFill" translatesAutoresizingMaskIntoConstraints="NO" id="mediaView" customClass="GADMediaView">
                    <rect key="frame" x="0.0" y="24" width="375" height="500"/>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                </view>

                <!-- Info Bar (AD badge) -->
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="infoBar">
                    <rect key="frame" x="0.0" y="0.0" width="375" height="24"/>
                    <subviews>
                        <imageView contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="adBadge">
                            <rect key="frame" x="347" y="2" width="20" height="20"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="20" id="badge-height"/>
                                <constraint firstAttribute="width" constant="20" id="badge-width"/>
                            </constraints>
                        </imageView>
                    </subviews>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                    <constraints>
                        <constraint firstItem="adBadge" firstAttribute="centerY" secondItem="infoBar" secondAttribute="centerY" id="badge-centerY"/>
                        <constraint firstItem="adBadge" firstAttribute="trailing" secondItem="infoBar" secondAttribute="trailing" constant="-8" id="badge-trailing"/>
                        <constraint firstAttribute="height" constant="24" id="infoBar-height"/>
                    </constraints>
                </view>

                <!-- Content below media view -->
                <label contentMode="scaleToFill" text="Headline" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="headline">
                    <rect key="frame" x="88" y="547" width="271" height="24"/>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                    <fontDescription key="fontDescription" type="system" pointSize="20"/>
                    <color key="textColor" systemColor="darkTextColor"/>
                </label>
                <label contentMode="scaleToFill" text="Body text goes here and can be long." lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="body">
                    <rect key="frame" x="88" y="575" width="271" height="17"/>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="calibratedWhite"/>
                    <fontDescription key="fontDescription" type="system" pointSize="14"/>
                    <color key="textColor" white="0.3333333" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                </label>
                <imageView contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="icon">
                    <rect key="frame" x="16" y="575" width="60" height="60"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="60" id="icon-height"/>
                        <constraint firstAttribute="width" constant="60" id="icon-width"/>
                    </constraints>
                </imageView>
                <button contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="ctaButton">
                    <rect key="frame" x="0.0" y="617" width="375" height="50"/>
                    <color key="backgroundColor" red="0.0" green="0.5" blue="1" alpha="0.59999999999999998" colorSpace="custom" customColorSpace="sRGB"/>
                    <state key="normal" title="INSTALL">
                        <color key="titleColor" white="1" alpha="1" colorSpace="calibratedWhite"/>
                    </state>
                </button>
            </subviews>
            <color key="backgroundColor" white="1" alpha="1" colorSpace="calibratedWhite"/>
            <constraints>
                <!-- Info Bar Constraints -->
                <constraint firstItem="infoBar" firstAttribute="leading" secondItem="iN0-l3-epB" secondAttribute="leading" id="infoBar-leading"/>
                <constraint firstItem="infoBar" firstAttribute="top" secondItem="iN0-l3-epB" secondAttribute="top" id="infoBar-top"/>
                <constraint firstAttribute="trailing" secondItem="infoBar" secondAttribute="trailing" id="infoBar-trailing"/>

                <!-- Media View Constraints - Positioned below info bar -->
                <constraint firstItem="mediaView" firstAttribute="top" secondItem="infoBar" secondAttribute="bottom" id="media-top"/>
                <constraint firstItem="mediaView" firstAttribute="leading" secondItem="iN0-l3-epB" secondAttribute="leading" id="media-leading"/>
                <constraint firstAttribute="trailing" secondItem="mediaView" secondAttribute="trailing" id="media-trailing"/>
                <constraint firstItem="mediaView" firstAttribute="height" relation="greaterThanOrEqual" constant="200" id="media-min-height"/>
                <constraint firstItem="mediaView" firstAttribute="height" relation="lessThanOrEqual" constant="400" id="media-max-height"/>

                <!-- Content Constraints (positioned below media view) -->
                <constraint firstItem="icon" firstAttribute="top" secondItem="mediaView" secondAttribute="bottom" constant="16" id="icon-top"/>
                <constraint firstItem="icon" firstAttribute="leading" secondItem="iN0-l3-epB" secondAttribute="leading" constant="16" id="icon-leading"/>
                <constraint firstItem="icon" firstAttribute="bottom" secondItem="ctaButton" secondAttribute="top" constant="-16" id="icon-bottom"/>

                <constraint firstItem="headline" firstAttribute="leading" secondItem="icon" secondAttribute="trailing" constant="12" id="headline-leading"/>
                <constraint firstItem="headline" firstAttribute="top" secondItem="icon" secondAttribute="top" id="headline-top-align"/>
                <constraint firstAttribute="trailing" secondItem="headline" secondAttribute="trailing" constant="16" id="headline-trailing"/>

                <constraint firstItem="body" firstAttribute="leading" secondItem="headline" secondAttribute="leading" id="body-leading"/>
                <constraint firstItem="body" firstAttribute="top" secondItem="headline" secondAttribute="bottom" constant="4" id="body-top"/>
                <constraint firstAttribute="trailing" secondItem="body" secondAttribute="trailing" constant="16" id="body-trailing"/>
                <constraint firstItem="body" firstAttribute="bottom" secondItem="ctaButton" secondAttribute="top" constant="-16" id="body-bottom"/>

                <constraint firstItem="ctaButton" firstAttribute="top" secondItem="body" secondAttribute="bottom" constant="16" id="cta-top"/>
                <constraint firstItem="ctaButton" firstAttribute="leading" secondItem="iN0-l3-epB" secondAttribute="leading" id="cta-leading"/>
                <constraint firstAttribute="trailing" secondItem="ctaButton" secondAttribute="trailing" id="cta-trailing"/>
                <constraint firstItem="ctaButton" firstAttribute="height" constant="50" id="cta-height"/>
                <constraint firstItem="ctaButton" firstAttribute="bottom" secondItem="iN0-l3-epB" secondAttribute="bottom" constant="-16" id="cta-bottom"/>

               </constraints>

            <connections>
                <outlet property="bodyView" destination="body" id="body-outlet"/>
                <outlet property="callToActionView" destination="ctaButton" id="cta-outlet"/>
                <outlet property="headlineView" destination="headline" id="headline-outlet"/>
                <outlet property="iconView" destination="icon" id="icon-outlet"/>
                <outlet property="mediaView" destination="mediaView" id="media-outlet"/>
            </connections>
            <point key="canvasLocation" x="140" y="19"/>
        </view>
    </objects>
    <resources>
        <systemColor name="darkTextColor">
            <color white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
        <systemColor name="l">
            <color red="0.0" green="0.46000000000000002" blue="0.89000000000000001" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
    </resources>
</document>