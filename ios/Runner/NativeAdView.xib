<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="16096" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="16087"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="NSObject"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="1" customClass="GADNativeAdView">
            <rect key="frame" x="0.0" y="0.0" width="360" height="300"/>
            <subviews>
                <stackView axis="vertical" distribution="fill" alignment="fill" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="stack">
                    <rect key="frame" x="0" y="0" width="400" height="260"/>
                    <subviews>
                        <view contentMode="scaleToFill" horizontalCompressionResistancePriority="1000" verticalCompressionResistancePriority="1000" translatesAutoresizingMaskIntoConstraints="NO" id="mediaView" customClass="GADMediaView">
                            <rect key="frame" x="10" y="90" width="350" height="300"/>
                            <constraints>
                                <constraint firstAttribute="width" constant="300" id="widthConstraint"/>
                                <constraint firstAttribute="height" constant="250" id="heightConstraint"/>
                            </constraints>
                        </view>

                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="50" verticalHuggingPriority="50" id="headlineLabel" text="Flood-It!" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO">
                            <fontDescription key="fontDescription" type="system" weight="bold" pointSize="24"/>
                            <color key="textColor" red="0" green="0" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        </label>

                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" id="bodyLabel" text="Deceptively simple + tantalizingly challenging = delightfully addictive!!" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO">
                            <fontDescription key="fontDescription" type="system" pointSize="14"/>
                            <color key="textColor" red="0" green="0" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        </label>

                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="ctaButton">
                            <rect key="frame" x="0" y="0" width="320" height="40"/>
                            <color key="backgroundColor" red="0" green="0.478" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            <constraint firstAttribute="height" constant="40" id="ctaHeight"/>
                            <fontDescription key="fontDescription" type="system" pointSize="16" weight="semibold"/>
                            <state key="normal" title="Install">
                                <color key="titleColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            </state>
                            <connections>
                                <action selector="didTapAd:" destination="-1" eventType="touchUpInside" id="ctaAction"/>
                            </connections>
                        </button>
                    </subviews>
                    <constraints>
                        <constraint firstAttribute="width" constant="320" id="stackWidth"/>
                    </constraints>
                </stackView>
            </subviews>
            <constraints>
                <constraint firstItem="stack" firstAttribute="top" secondItem="1" secondAttribute="top" constant="20" id="topConstraint"/>
                <constraint firstItem="stack" firstAttribute="leading" secondItem="1" secondAttribute="leading" constant="20" id="leadingConstraint"/>
                <constraint firstItem="1" firstAttribute="trailing" secondItem="stack" secondAttribute="trailing" constant="20" id="trailingConstraint"/>
                <constraint firstItem="1" firstAttribute="bottom" secondItem="stack" secondAttribute="bottom" constant="20" id="bottomConstraint"/>
            </constraints>
            <connections>
                <outlet property="headlineView" destination="headlineLabel" id="headlineOutlet"/>
                <outlet property="mediaView" destination="mediaView" id="mediaOutlet"/>
                <outlet property="bodyView" destination="bodyLabel" id="bodyOutlet"/>
                <outlet property="callToActionView" destination="ctaButton" id="ctaOutlet"/>
            </connections>
        </view>
    </objects>
</document>


