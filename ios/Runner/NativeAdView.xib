            <color key="backgroundColor" white="1" alpha="1" colorSpace="calibratedWhite"/>
            <constraints>
                <constraint firstItem="contentContainer" firstAttribute="bottom" secondItem="iN0-l3-epB" secondAttribute="bottom" constant="-20" id="container-bottom"/>
                <constraint firstItem="contentContainer" firstAttribute="height" constant="120" id="container-height"/>
                <constraint firstItem="contentContainer" firstAttribute="leading" secondItem="iN0-l3-epB" secondAttribute="leading" id="container-leading"/>
                <constraint firstAttribute="trailing" secondItem="contentContainer" secondAttribute="trailing" id="container-trailing"/>
